# Environment configuration for MedGraph

# ── LLM Provider ──────────────────────────────────────────────────────────────
# Primary model (Ollama local - MedGemma)
OLLAMA_BASE_URL=http://localhost:11434
MEDGEMMA_MODEL=medgemma1.5

# Fallback model (OpenAI)
OPENAI_API_KEY=sk-...your-key-here...
OPENAI_FALLBACK_MODEL=gpt-4o-mini

# Set to "ollama" or "openai" to force a provider (default: auto-detect)
LLM_PROVIDER=auto

# ── API Server ────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# ── Graph Settings ────────────────────────────────────────────────────────────
# Maximum Q&A rounds before proceeding to case building
MAX_QUESTION_ROUNDS=5
# Maximum treatment plan retries on validation failure
MAX_TREATMENT_RETRIES=2

# ── Storage ───────────────────────────────────────────────────────────────────
# SQLite file for LangGraph checkpointer (leave blank for in-memory)
CHECKPOINT_DB_PATH=./checkpoints.db

# Directory for saving final reports
REPORTS_DIR=./reports

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
